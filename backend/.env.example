# ==========================================================
# Render -> Environment Variables (backend)
# Copy each KEY / VALUE pair into Render > Service > Environment
# ==========================================================

# Render sets PORT automatically, but keep this for local dev
PORT=8000
NODE_ENV=production

# Public URL of THIS backend service on Render (no trailing slash).
# Twilio webhooks are built from this value.
PUBLIC_URL=https://your-backend.onrender.com

# Your Vercel frontend origin(s), comma separated. Used for CORS.
FRONTEND_URL=https://your-app.vercel.app,http://localhost:5500

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/aicallassistant?retryWrites=true&w=majority

# Dashboard login (used by the frontend login screen)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
SESSION_SECRET=a_long_random_string_at_least_32_chars

# ---- Optional seed values ----
# These only seed the database the very first time it starts.
# After that, edit everything from the dashboard Settings page.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
MY_PHONE_NUMBER=+919876543210
GEMINI_API_KEY=your_gemini_api_key
